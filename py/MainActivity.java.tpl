    private class Bridge {
        @JavascriptInterface public void toast(String m) { showToast(m); }

        @JavascriptInterface
        public void vibrate(long ms) {
            try {
                Vibrator v = (Vibrator) getSystemService(Context.VIBRATOR_SERVICE);
                if (v != null) v.vibrate(ms);
            } catch (Exception e) { }
        }

        @JavascriptInterface
        public void share(String text) {
            try {
                Intent i = new Intent(Intent.ACTION_SEND);
                i.setType("text/plain");
                i.putExtra(Intent.EXTRA_TEXT, text);
                Intent c = Intent.createChooser(i, APP_NAME);
                c.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
                startActivity(c);
            } catch (Exception e) { }
        }

        @JavascriptInterface
        public void copy(final String text) {
            runOnUiThread(new Runnable() {
                public void run() {
                    ClipboardManager cm = (ClipboardManager) getSystemService(Context.CLIPBOARD_SERVICE);
                    if (cm != null) cm.setPrimaryClip(ClipData.newPlainText("text", text));
                }
            });
        }

        @JavascriptInterface public void openUrl(String url) { openExternal(url); }

        @JavascriptInterface
        public void exit() {
            runOnUiThread(new Runnable() { public void run() { finish(); } });
        }

        @JavascriptInterface
        public void keepScreenOn(final boolean on) {
            runOnUiThread(new Runnable() {
                public void run() {
                    if (on) getWindow().addFlags(WindowManager.LayoutParams.FLAG_KEEP_SCREEN_ON);
                    else getWindow().clearFlags(WindowManager.LayoutParams.FLAG_KEEP_SCREEN_ON);
                }
            });
        }

        @JavascriptInterface public String appName() { return APP_NAME; }
        @JavascriptInterface public String appVersion() { return APP_VERSION; }
        @JavascriptInterface public String packageName() { return getPackageName(); }
        @JavascriptInterface public int sdkInt() { return Build.VERSION.SDK_INT; }
    }

    // -------------------------------------------------------------------- splash
    private void buildSplash() {
        if (SPLASH_MODE == 0) { minDone = true; return; }
        FrameLayout s = new FrameLayout(this);
        s.setBackgroundColor(Color.parseColor(SPLASH_BG));
        s.setClickable(true);
        if (SPLASH_MODE == 2) {
            ImageView iv = new ImageView(this);
            iv.setScaleType(ImageView.ScaleType.CENTER_CROP);
            @@SPLASH_IMAGE_CODE@@
            s.addView(iv, new FrameLayout.LayoutParams(
                    ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT));
        } else {
            LinearLayout l = new LinearLayout(this);
            l.setOrientation(LinearLayout.VERTICAL);
            l.setGravity(Gravity.CENTER);
            int fg = Color.parseColor(SPLASH_FG);

            ImageView ic = new ImageView(this);
            ic.setImageResource(R.mipmap.ic_launcher);
            l.addView(ic, new LinearLayout.LayoutParams(dp(96), dp(96)));

            TextView t = new TextView(this);
            t.setText(APP_NAME);
            t.setTextColor(fg);
            t.setTextSize(24);
            t.setGravity(Gravity.CENTER);
            t.setPadding(dp(24), dp(16), dp(24), 0);
            l.addView(t);

            if (SPLASH_TAGLINE.length() > 0) {
                TextView g = new TextView(this);
                g.setText(SPLASH_TAGLINE);
                g.setTextColor(fg);
                g.setAlpha(0.75f);
                g.setTextSize(14);
                g.setGravity(Gravity.CENTER);
                g.setPadding(dp(24), dp(6), dp(24), 0);
                l.addView(g);
            }
            if (SPLASH_SHOW_VERSION) {
                TextView vv = new TextView(this);
                vv.setText("v" + APP_VERSION);
                vv.setTextColor(fg);
                vv.setAlpha(0.55f);
                vv.setTextSize(12);
                vv.setGravity(Gravity.CENTER);
                vv.setPadding(dp(24), dp(10), dp(24), 0);
                l.addView(vv);
            }
            if (SPLASH_SPINNER) {
                ProgressBar pb = new ProgressBar(this);
                LinearLayout.LayoutParams lp = new LinearLayout.LayoutParams(dp(32), dp(32));
                lp.topMargin = dp(28);
                l.addView(pb, lp);
            }
            s.addView(l, new FrameLayout.LayoutParams(
                    ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT));
        }
        root.addView(s, new FrameLayout.LayoutParams(
                ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT));
        splash = s;
        ui.postDelayed(new Runnable() {
            public void run() { minDone = true; maybeHideSplash(); }
        }, SPLASH_MS);
        ui.postDelayed(new Runnable() {
            public void run() { pageReady = true; maybeHideSplash(); }
        }, SPLASH_MS + 12000);
    }

    private void maybeHideSplash() {
        if (splash == null || !pageReady || !minDone) return;
        final View s = splash;
        splash = null;
        s.animate().alpha(0f).setDuration(280).withEndAction(new Runnable() {
            public void run() { root.removeView(s); }
        });
    }
}
