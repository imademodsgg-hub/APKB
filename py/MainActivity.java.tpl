    // ----------------------------------------------------------------- downloads
    private String jsq(String s) {
        if (s == null) return "";
        return s.replace("\\", "\\\\").replace("'", "\\'").replace("\n", " ").replace("\r", " ");
    }

    private void handleDownload(String url, String ua, String cd, String mime) {
        if (!DOWNLOADS) { openExternal(url); return; }
        String name = URLUtil.guessFileName(url, cd, mime);
        if (url.startsWith("blob:")) {
            web.evaluateJavascript("(function(){var x=new XMLHttpRequest();x.open('GET','" + jsq(url)
                    + "',true);x.responseType='blob';x.onload=function(){var r=new FileReader();"
                    + "r.onloadend=function(){ApkbDL.save(r.result,'" + jsq(mime) + "','" + jsq(name)
                    + "');};r.readAsDataURL(x.response);};x.send();})();", null);
            return;
        }
        if (url.startsWith("data:")) { saveDataUrl(url, mime, name); return; }
        try {
            DownloadManager.Request r = new DownloadManager.Request(Uri.parse(url));
            r.setMimeType(mime);
            r.addRequestHeader("User-Agent", ua);
            String cookie = CookieManager.getInstance().getCookie(url);
            if (cookie != null) r.addRequestHeader("Cookie", cookie);
            r.setNotificationVisibility(DownloadManager.Request.VISIBILITY_VISIBLE_NOTIFY_COMPLETED);
            r.setDestinationInExternalPublicDir(Environment.DIRECTORY_DOWNLOADS, name);
            ((DownloadManager) getSystemService(Context.DOWNLOAD_SERVICE)).enqueue(r);
            showToast("Downloading " + name);
        } catch (Exception e) {
            openExternal(url);
        }
    }

    private void saveDataUrl(String dataUrl, String mime, String name) {
        try {
            int comma = dataUrl.indexOf(',');
            String head = dataUrl.substring(0, comma);
            String body = dataUrl.substring(comma + 1);
            byte[] bytes;
            if (head.indexOf(";base64") >= 0) bytes = Base64.decode(body, Base64.DEFAULT);
            else bytes = Uri.decode(body).getBytes("UTF-8");
            if ((mime == null || mime.length() == 0) && head.startsWith("data:")) {
                int semi = head.indexOf(';');
                mime = head.substring(5, semi > 0 ? semi : head.length());
            }
            saveBytes(bytes, mime, name);
        } catch (Exception e) {
            showToast("Save failed: " + e.getMessage());
        }
    }

