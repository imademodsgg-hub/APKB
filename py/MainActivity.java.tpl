    private boolean handleUrl(String url) {
        if (url == null) return false;
        Uri u = Uri.parse(url);
        String sc = u.getScheme() == null ? "" : u.getScheme().toLowerCase();
        if (sc.equals("file") || sc.equals("about") || sc.equals("data")
                || sc.equals("blob") || sc.equals("javascript")) return false;
        if (sc.equals("http") || sc.equals("https")) {
            String h = u.getHost() == null ? "" : u.getHost();
            if (h.equals(VIRTUAL_HOST)) return false;
            String startHost = Uri.parse(START_URL).getHost();
            if (startHost == null) startHost = "";
            if (EXTERNAL_BROWSER && !h.equals(startHost)) { openExternal(url); return true; }
            return false;
        }
        openExternal(url);   // tel:, mailto:, sms:, geo:, market:, intent: ...
        return true;
    }

    private void openExternal(String url) {
        try {
            Intent i;
            if (url.startsWith("intent:")) i = Intent.parseUri(url, Intent.URI_INTENT_SCHEME);
            else i = new Intent(Intent.ACTION_VIEW, Uri.parse(url));
            i.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
            startActivity(i);
        } catch (Exception e) {
            showToast("No app can open this link");
        }
    }

    private String mimeOf(String name) {
        String n = name.toLowerCase();
        if (n.endsWith(".html") || n.endsWith(".htm")) return "text/html";
        if (n.endsWith(".js") || n.endsWith(".mjs")) return "application/javascript";
        if (n.endsWith(".css")) return "text/css";
        if (n.endsWith(".json") || n.endsWith(".map")) return "application/json";
        if (n.endsWith(".svg")) return "image/svg+xml";
        if (n.endsWith(".wasm")) return "application/wasm";
        if (n.endsWith(".webmanifest")) return "application/manifest+json";
        if (n.endsWith(".txt")) return "text/plain";
        int i = n.lastIndexOf('.');
        if (i >= 0) {
            String m = MimeTypeMap.getSingleton().getMimeTypeFromExtension(n.substring(i + 1));
            if (m != null) return m;
        }
        return "application/octet-stream";
    }

    private WebResourceResponse intercept(Uri u) {
        if (u == null || !VIRTUAL_HOST.equals(u.getHost())) return null;
        String path = u.getPath();
        if (path == null || path.equals("/") || path.length() == 0) path = "/index.html";
        String rel = path.substring(1);
        try {
            InputStream in = getAssets().open("www/" + rel);
            String mime = mimeOf(rel);
            boolean text = mime.startsWith("text/") || mime.indexOf("javascript") >= 0
                    || mime.indexOf("json") >= 0 || mime.indexOf("xml") >= 0;
            return new WebResourceResponse(mime, text ? "UTF-8" : null, in);
        } catch (Exception e) {
            return new WebResourceResponse("text/plain", "UTF-8", 404, "Not Found", null,
                    new ByteArrayInputStream(new byte[0]));
        }
    }

